# ===== required =====
# Token Plan 套餐专属 API Key（sk-sp- 前缀）
QWEN_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== optional (shown with defaults) =====
# Token Plan 区域根地址，用于推导文本/图像端点；可被下面两个覆盖
# QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com
# 文本透传目标（OpenAI 兼容模式）
# QWEN_TEXT_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 图像转换目标（multimodal-generation）
# QWEN_IMAGE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# 对外暴露的 API Key：客户端必须携带；留空则关闭鉴权
# EXPOSED_API_KEY=sk-your-exposed-key

# 监听地址
# LISTEN_ADDR=:8080

# 图像模型兜底/映射目标
# QWEN_IMAGE_MODEL=qwen-image-2.0
# 细粒度模型别名：MODEL_ALIAS_<openai模型名>=<qwen模型名>
# MODEL_ALIAS_gpt-image-1=qwen-image-2.0-pro
# MODEL_ALIAS_dall-e-3=qwen-image-2.0

# b64_json 模式并发下载数 / 单张图片大小上限（字节）
# IMAGE_DOWNLOAD_CONCURRENCY=4
# IMAGE_MAX_BYTES=20971520

# 图像上游超时
# UPSTREAM_TIMEOUT=180s

# 日志级别：debug/info/warn/error
# LOG_LEVEL=info